<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><title>KerjaGimana — Cari tahu dulu / 20s</title><link rel="stylesheet" href="style-v2.css"><script src="assets/gsap.min.js"></script></head>
<body>
  <main id="root" data-composition-id="kerjagimana-horizontal" data-start="0" data-duration="20" data-width="1920" data-height="1080">
    <div id="film">
      <section id="hook" class="type-scene"><div id="hook-camera" class="camera">
        <span id="h-kerja" class="word hook-word" style="left:500px;top:290px">Kerja</span>
        <span id="h-di" class="word hook-word" style="left:500px;top:505px">di</span>
        <span id="h-sana" class="word hook-word" style="left:680px;top:505px">sana.</span>
      </div></section>
      <section id="question" class="type-scene"><div id="question-camera" class="camera">
        <span id="q-yakin" class="word question-word" style="left:280px;top:245px">Yakin</span>
        <span id="q-udah" class="word question-word" style="left:720px;top:245px">udah</span>
        <span id="q-tahu" class="word question-word red" style="left:280px;top:480px">tahu</span>
        <span id="q-dalem" class="word question-word" style="left:670px;top:480px">dalemnya?</span>
      </div></section>
      <section id="photos" data-layout-ignore>
        <div id="photo-work" class="photo-scene"><img id="image-work" src="assets/revision-20s/work.jpg" alt="Ilustrasi rekan kerja berkolaborasi"><div class="photo-shade"></div></div>
        <div id="photo-salary" class="photo-scene"><img id="image-salary" src="assets/revision-20s/salary.jpg" alt="Ilustrasi menghitung informasi keuangan"><div class="photo-shade"></div></div>
        <div id="photo-interview" class="photo-scene"><img id="image-interview" src="assets/revision-20s/interview.jpg" alt="Ilustrasi percakapan interview"><div class="photo-shade"></div></div>
      </section>
      <div id="work-camera" class="camera">
        <span id="p-work-one" class="word photo-word" style="left:160px;top:415px">Pengalaman</span>
        <span id="p-work-two" class="word photo-word" style="left:160px;top:590px">kerja.</span>
      </div>
      <div id="salary-camera" class="camera">
        <span id="p-salary-one" class="word photo-word" style="left:160px;top:400px">Ringkasan</span>
        <span id="p-salary-two" class="word photo-word" style="left:160px;top:575px">gaji.</span>
      </div>
      <p id="salary-qualifier">Saat data mencukupi.</p>
      <div id="interview-camera" class="camera">
        <span id="p-interview-one" class="word photo-word" style="left:160px;top:420px">Proses</span>
        <span id="p-interview-two" class="word photo-word" style="left:160px;top:595px">interview.</span>
      </div>
      <div id="paper" data-layout-ignore></div>
      <section id="compare" class="type-scene"><div id="compare-camera" class="camera">
        <span id="c-bandingkan" class="word compare-word" style="left:250px;top:270px">Bandingkan</span>
        <span id="c-sebelum" class="word compare-word" style="left:250px;top:505px">sebelum</span>
        <span id="c-memilih" class="word compare-word" style="left:930px;top:505px">memilih.</span>
      </div></section>
      <div id="closing-black" data-layout-ignore></div>
      <section id="closing" class="type-scene"><div id="closing-camera" class="camera">
        <span id="f-sebelum" class="word final-word" style="left:280px;top:320px">Sebelum</span>
        <span id="f-kerja" class="word final-word" style="left:795px;top:320px">kerja</span>
        <span id="f-disana" class="word final-word" style="left:1095px;top:320px">di sana,</span>
        <span id="f-cari" class="word final-word" style="left:280px;top:565px">cari</span>
        <span id="f-tahu" class="word final-word red" style="left:525px;top:565px">tahu</span>
        <span id="f-dulu" class="word final-word" style="left:830px;top:565px">dulu.</span>
      </div></section>
      <div id="brand"><span class="brand-symbol">K<span>.</span></span><span>kerja<span class="brand-light">gimana</span></span></div>
      <div id="cta">Cari perusahaan <span>↗</span></div>
    </div>
  </main>
  <script src="animation-v2.js"></script>
</body>
</html>
