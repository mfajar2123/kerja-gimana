NUXT_SUPABASE_URL=
NUXT_SUPABASE_PUBLISHABLE_KEY=
# Server only: accepts a modern sb_secret_... key or legacy service_role key.
NUXT_SUPABASE_SERVICE_ROLE_KEY=
NUXT_RATE_LIMIT_SECRET=
NUXT_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Use HTTPS and the actual origin for both URLs in production.
# Auth email SMTP (including Gmail app passwords) is configured in Supabase, not in Nuxt env.
NUXT_PUBLIC_DEMO_DATA_ENABLED=false
