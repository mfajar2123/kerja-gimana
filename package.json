{
  "name": "kerjagimana",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.21.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/setup-env.mjs && node node_modules/nuxt/bin/nuxt.mjs dev --host localhost",
    "setup:env": "node scripts/setup-env.mjs",
    "build": "node node_modules/nuxt/bin/nuxt.mjs build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "prepare": "node node_modules/nuxt/bin/nuxt.mjs prepare",
    "preview": "node --env-file-if-exists=.env .output/server/index.mjs",
    "check": "node node_modules/nuxt/bin/nuxt.mjs typecheck",
    "check:launch": "node scripts/check-launch.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:backend": "node scripts/test-backend.mjs",
    "qa:auth": "node scripts/qa-auth.mjs",
    "qa:features": "node scripts/qa-features.mjs",
    "qa:public-data": "node scripts/qa-public-data.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "demo:clean": "node scripts/seed-demo.mjs --clean",
    "test:rls": "node scripts/test-rls.mjs",
    "qa:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lucide/vue": "1.52.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "h3": "2.0.1",
    "nuxt": "4.6.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.12.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12",
    "wrangler": "4.150.0"
  },
  "optionalDependencies": {
    "node-win-x64": "22.23.3"
  }
}
